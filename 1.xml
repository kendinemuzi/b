const EST_TOTAL = (27.3 + 28.8) * 1048576;
let got = 0;
function show(p) { const v = Math.min(100, Math.round(p * 100)); fill.style.width = v + '%'; txt.textContent = 'Loading ' + v + '%'; }
function addBytes(n) { got += n; show(Math.min(got / EST_TOTAL, 1) * 0.85); }

async function fetchPart(url) {
    for (let a = 0; a < 4; a++) {
        let seen = 0;
        try {
            const r = await fetch(a ? url + '?r=' + Date.now() : url);
            if (!r.ok) throw new Error(r.status);
            const rd = r.body.getReader(), ch = [];
            for (;;) { const { done, value } = await rd.read(); if (done) break; ch.push(value); seen += value.length; addBytes(value.length); }
            const out = new Uint8Array(seen); let o = 0;
            for (const c of ch) { out.set(c, o); o += c.length; }
            return out;
        } catch (e) { got -= seen; await new Promise(r => setTimeout(r, 1000 * (a + 1))); }
    }
    throw new Error('download failed');
}

function pool(urls, n) {
    const res = urls.map(() => { let s, j; const p = new Promise((a, b) => { s = a; j = b; }); return { p, s, j }; });
    let i = 0;
    const next = () => { if (i >= urls.length) return; const k = i++; fetchPart(urls[k]).then(v => { res[k].s(v); next(); }, e => { res[k].j(e); next(); }); };
    for (let k = 0; k < n; k++) next();
    return res.map(r => r.p);
}

let brotliMod = null;
async function brotli() { if (!brotliMod) { brotliMod = await import(BROTLI_JS); await brotliMod.default(); } return brotliMod; }

async function joinParts(promises, isRaw, type) {
    const first = await promises[0];
    const out = [];
    if (isRaw(first)) {
        out.push(first);
        for (let k = 1; k < promises.length; k++) out.push(await promises[k]);
    } else {
        const b = await brotli();
        const ds = new b.DecompressStream();
        for (let k = 0; k < promises.length; k++) {
            const part = k ? await promises[k] : first;
            let off = 0, code;
            do {
                const r = ds.decompress(part.subarray(off), 1 << 21);
                out.push(r.buf); off += r.input_offset; code = r.code;
                r.free && r.free();
            } while (code === b.BrotliStreamResultCode.NeedsMoreOutput || (code === b.BrotliStreamResultCode.NeedsMoreInput && off < part.length));
            promises[k] = null;
        }
        ds.free && ds.free();
    }
    return URL.createObjectURL(new Blob(out, { type: type }));
}

const isWasm = u => u[0] === 0 && u[1] === 0x61 && u[2] === 0x73 && u[3] === 0x6d;
const isData = u => String.fromCharCode.apply(null, u.subarray(0, 12)) === 'UnityWebData';

